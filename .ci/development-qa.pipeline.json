{
  "version": 1,
  "required_labels": [
    "containers",
    "linux",
    "x64"
  ],
  "triggers": {
    "branches": [
      "internal-beta-candidate"
    ],
    "tags": [],
    "manual": true
  },
  "env": {
    "NODE_VERSION": "22.23.2",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "CODEQL_CLI": "/opt/codeql/bundle-2.26.2/codeql",
    "CODEQL_BUNDLE_SHA256": "cb361567fa1bdb9d322da4240f621b36f245e4d7bb97db3c3a2ad7f743c8e8e7",
    "LUNCHLINEUP_DEVELOPMENT_QA": "1"
  },
  "artifacts": [
    ".release/internal-ci/**"
  ],
  "name": "Disposable development QA \u2014 no release signing or deployment",
  "timeout_seconds": 14400,
  "steps": [
    {
      "name": "Materialize and verify exact candidate source",
      "run": "set -euo pipefail; python3 scripts/check-internal-ci-storage.py; node scripts/materialize-internal-ci-source.mjs --artifact-root \"$PWD/.release/internal-ci/$CI_COMMIT_SHA\" --run-root \"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID\"",
      "timeout_seconds": 600
    },
    {
      "name": "Install locked JavaScript dependencies",
      "run": "set -euo pipefail; source_context=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/source-context.json\"; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; test -f \"$source_context\"; test -d \"$build_root\"; bash \"$build_root/scripts/install-internal-ci-dependencies.sh\" --source-context \"$source_context\"",
      "timeout_seconds": 1800
    },
    {
      "name": "Build contracts, typecheck web, and check repair helpers",
      "run": "set -euo pipefail; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; cd \"$build_root\"; npm run build --workspace @lunchlineup/api-contract; npm run build --workspace @lunchlineup/config; npm run build --workspace @lunchlineup/rbac; npm run typecheck --workspace @lunchlineup/web; (cd apps/web && npx vitest run --project=unit tests/unit/settings-request.test.ts tests/unit/settings-save-state.test.ts tests/unit/invitation-recovery.test.ts tests/unit/profile-save-state.test.ts tests/unit/staff-action-confirmation.test.ts tests/unit/time-card-mutation-result.test.ts); npx playwright install chromium",
      "timeout_seconds": 1200
    },
    {
      "name": "Disposable database integration",
      "run": "set -euo pipefail; source_context=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/source-context.json\"; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; test -f \"$source_context\"; test -d \"$build_root\"; bash \"$build_root/scripts/run-internal-ci-integration.sh\" --source-context \"$source_context\"",
      "timeout_seconds": 3600
    },
    {
      "name": "Run disposable application browser tests",
      "run": "set -euo pipefail; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; bash \"$build_root/scripts/run-development-browser-qa.sh\" --source-context \"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/source-context.json\"",
      "timeout_seconds": 9000
    }
  ]
}
