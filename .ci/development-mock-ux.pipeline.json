{
  "version": 1,
  "name": "Fixed eight existing mock UX cases — disposable only",
  "required_labels": [
    "linux",
    "x64"
  ],
  "triggers": {
    "branches": [],
    "tags": [],
    "manual": true
  },
  "env": {
    "NODE_VERSION": "22.23.2",
    "NODE_OPTIONS": "--max-old-space-size=4096",
    "LUNCHLINEUP_DEVELOPMENT_QA": "1",
    "DATA_TARGET_ENV": "disposable",
    "APP_ENV": "test",
    "DEPLOY_ENV": "test",
    "NEXT_PUBLIC_APP_ORIGIN": "http://127.0.0.1:8080",
    "NEXT_TELEMETRY_DISABLED": "1"
  },
  "artifacts": [
    ".release/internal-ci/**"
  ],
  "timeout_seconds": 4200,
  "steps": [
    {
      "name": "Materialize exact source",
      "timeout_seconds": 600,
      "run": "set -euo pipefail; python3 scripts/check-internal-ci-storage.py; node scripts/materialize-internal-ci-source.mjs --artifact-root \"$PWD/.release/internal-ci/$CI_COMMIT_SHA\" --run-root \"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID\""
    },
    {
      "name": "Locked dependencies and Chromium acquisition",
      "timeout_seconds": 1800,
      "run": "set -euo pipefail; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; bash \"$build_root/scripts/install-internal-ci-dependencies.sh\" --source-context \"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/source-context.json\"; cd \"$build_root/apps/web\"; \"$build_root/node_modules/.bin/playwright\" install chromium"
    },
    {
      "name": "Only eight existing mock UX cases",
      "timeout_seconds": 1800,
      "run": "set -euo pipefail; build_root=\"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/build\"; bash \"$build_root/scripts/run-internal-ci-mock-playwright.sh\" --source-context \"$RUNNER_TEMP/lunchlineup-source-$CI_RUN_ID/source-context.json\""
    }
  ]
}
