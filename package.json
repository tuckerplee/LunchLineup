{
  "name": "lunchlineup",
  "private": true,
  "packageManager": "npm@10.8.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "postinstall": "npm run generate --workspace @lunchlineup/db",
    "test": "turbo run test",
    "test:migration": "node scripts/run-migration-tests.mjs",
    "test:integration": "node --test --test-concurrency=1 tests/integration/*.test.mjs",
    "audit:prod": "node scripts/audit-prod.mjs",
    "seed:e2e": "node scripts/seed-e2e.mjs",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "type-check": "npm run typecheck",
    "clean": "turbo run clean"
  },
  "devDependencies": {
    "@nestjs/common": "^11.2.6",
    "@nestjs/core": "^11.2.6",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitest/browser": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "ajv": "^8.18.0",
    "eslint": "^10.4.1",
    "file-type": "^21.3.1",
    "license-checker": "25.0.1",
    "postcss": "^8.5.23",
    "qs": "^6.16.0",
    "turbo": "latest",
    "vitest": "^4.1.11"
  },
  "optionalDependencies": {
    "@next/swc-darwin-arm64": "16.3.3",
    "@next/swc-darwin-x64": "16.3.3",
    "@next/swc-linux-arm64-gnu": "16.3.3",
    "@next/swc-linux-arm64-musl": "16.3.3",
    "@next/swc-linux-x64-gnu": "16.3.3",
    "@next/swc-linux-x64-musl": "16.3.3",
    "@next/swc-win32-arm64-msvc": "16.3.3",
    "@next/swc-win32-x64-msvc": "16.3.3"
  },
  "dependencies": {
    "pg": "8.16.3"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "minimatch@>=10": {
      "brace-expansion": "5.0.9"
    },
    "casbin": {
      "csv-parse": "7.0.2"
    }
  }
}
