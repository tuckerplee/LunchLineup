# LunchLineup PRODUCTION runtime environment template. NO SECRETS BELONG IN THIS FILE.
#
# Copy to a protected location OUTSIDE the checkout (for example
# /etc/lunchlineup/runtime.env, mode 0600, root-owned), fill every marker, then run:
#
#   node scripts/check-production-env.mjs /etc/lunchlineup/runtime.env --verify-local-secret-files
#
# Markers (the checker refuses any file that still contains one):
#   OWNER:...      a value only the business owner can supply (account, decision, approval)
#   GENERATE_ME    a secret the operator generates (hint beside it), never reused across keys
# Everything else is a concrete production default that you normally keep as-is.
# The public NEXT_PUBLIC_* values are compiled into the web image at build time.
# See docs/launch/OWNER-CHECKLIST.md for where each OWNER value comes from.
# Keep comments on their own lines: the env parser treats the whole right-hand side as the value.

# -- 1. Runtime identity -------------------------------------------------------
NODE_ENV=production
DATA_TARGET_ENV=production
# Set by the release pipeline to the exact 40-hex candidate commit and public-build hash.
DEPLOY_RELEASE_SHA=GENERATE_ME
PUBLIC_BUILD_CONFIG_SHA256=GENERATE_ME
MIGRATION_PRODUCTION_CONFIRM=apply-lunchlineup-production-migrations

# -- 2. Public hostnames (OWNER: Cloudflare DNS and tunnel/proxy for the production host)
# No beta.*, dev.*, localhost, private-IP or example hosts are allowed here.
DOMAIN=OWNER:production-hostname
PRODUCTION_API_HEALTH_URL=OWNER:https://production-hostname/api/health
LUNCHLINEUP_STATUS_HEALTH_URL=OWNER:https://production-hostname/health
CADDY_SITE_ADDRESSES=OWNER:https://production-hostname,https://www.production-hostname
ALLOWED_HOSTS=OWNER:production-hostname,www.production-hostname
ALLOWED_ORIGINS=OWNER:https://production-hostname,https://www.production-hostname
APP_ORIGIN=OWNER:https://production-hostname
NEXT_PUBLIC_APP_ORIGIN=OWNER:https://production-hostname
NEXT_PUBLIC_APP_URL=OWNER:https://production-hostname
NEXT_PUBLIC_APP_ENV=production
NEXT_PUBLIC_API_URL=/api/v2
COOKIE_SECURE=true
API_HOST_BIND=127.0.0.1
TRUST_PROXY=loopback,linklocal,uniquelocal
# Optional. CT940 nginx address(es) Caddy trusts for X-Forwarded-* (space-separated
# IPv4/CIDR). Default 10.231.10.30/32; set 10.1.20.20/32 after the renumbering.
# CADDY_TRUSTED_PROXIES=10.1.20.20/32
# Monitored operational mailbox on the production domain.
ADMIN_EMAIL=OWNER:ops-mailbox

# -- 3. Datastores (service names are the in-compose hostnames; keep them) ------
POSTGRES_USER=lunchlineup_admin
POSTGRES_DB=lunchlineup
# openssl rand -hex 24
POSTGRES_PASSWORD=GENERATE_ME
# openssl rand -hex 24 (must differ from POSTGRES_PASSWORD)
APP_DB_USER=lunchlineup_app
APP_DB_PASSWORD=GENERATE_ME
# openssl rand -hex 32
PLATFORM_ADMIN_DB_CONTEXT_SECRET=GENERATE_ME
# postgresql://APP_DB_USER:<percent-encoded APP_DB_PASSWORD>@postgres:5432/lunchlineup
DATABASE_URL=GENERATE_ME
# postgresql://POSTGRES_USER:<percent-encoded POSTGRES_PASSWORD>@postgres:5432/lunchlineup
MIGRATION_DATABASE_URL=GENERATE_ME
# openssl rand -hex 32
REDIS_PASSWORD=GENERATE_ME
# redis://default:<REDIS_PASSWORD>@redis:6379
REDIS_URL=GENERATE_ME
RABBITMQ_USER=lunchlineup
# openssl rand -hex 24
RABBITMQ_PASSWORD=GENERATE_ME
# amqp://RABBITMQ_USER:<percent-encoded RABBITMQ_PASSWORD>@rabbitmq:5672
RABBITMQ_URL=GENERATE_ME

# -- 4. Application secrets (all distinct; generate each with openssl rand -hex 32) --
JWT_SECRET=GENERATE_ME
JWT_REFRESH_SECRET=GENERATE_ME
SESSION_SECRET=GENERATE_ME
OTP_HMAC_SECRET=GENERATE_ME
CSRF_SECRET=GENERATE_ME
MFA_SECRET_ENCRYPTION_KEY_CURRENT=GENERATE_ME
MFA_SECRET_ENCRYPTION_KEY_PREVIOUS=
MFA_SECRET_ENCRYPTION_KEY=
WEBHOOK_DELIVERY_ENCRYPTION_KEY_CURRENT=GENERATE_ME
PASSWORD_RESET_OUTBOX_ENCRYPTION_KEY=GENERATE_ME
AVAILABILITY_IMPORT_ENCRYPTION_KEY=GENERATE_ME
STAFF_INVITATION_OUTBOX_ENCRYPTION_KEY=GENERATE_ME
PASSWORD_RESET_EMAIL_OUTBOX_ENABLED=true
STAFF_INVITATION_OUTBOX_ENABLED=true
# Secret files are mounted by the host; create them yourself (mode 0600) before deploying.
METRICS_TOKEN_FILE=/run/secrets/metrics_token
RETENTION_PURGE_SERVICE_TOKEN_SECRET_FILE=/run/secrets/retention_purge_token
CONTROL_PLANE_ADMIN_TOKEN_SECRET_FILE=/run/secrets/control_plane_admin_token.host
CONTROL_PLANE_ADMIN_TOKEN_FILE=/run/secrets/control_plane_admin_token

# -- 5. Email: Resend (OWNER account; see docs/launch/email-setup.md) -----------
RESEND_API_KEY=OWNER:re_live_api_key
RESEND_WEBHOOK_SECRET=OWNER:whsec_from_resend_webhook
# Sender must be on a domain verified in Resend (SPF, DKIM and DMARC published).
EMAIL_FROM=OWNER:LunchLineup <no-reply@production-hostname>
# Owner-controlled inbox that receives the one readiness test message.
RESEND_PREFLIGHT_RECIPIENT=OWNER:owner-inbox
RESEND_PREFLIGHT_TIMEOUT_MS=10000
SCHEDULE_PUBLISHED_EMAIL_ENABLED=true
SCHEDULE_PUBLISHED_EMAIL_PROVIDER_TIMEOUT_MS=10000

# -- 6. Billing: Stripe LIVE mode (OWNER account) -------------------------------
STRIPE_SECRET_KEY=OWNER:sk_live_key
STRIPE_WEBHOOK_SECRET=OWNER:whsec_stripe_webhook
STRIPE_WEBHOOK_ENDPOINT_ID=OWNER:we_endpoint_id
STRIPE_METER_ERROR_WEBHOOK_SECRET=OWNER:whsec_meter_error_webhook
STRIPE_METER_ERROR_EVENT_DESTINATION_ID=OWNER:ed_destination_id
STRIPE_PRICE_STARTER=OWNER:price_starter
STRIPE_PRICE_GROWTH=OWNER:price_growth
STRIPE_PRICE_ENTERPRISE=OWNER:price_enterprise
STRIPE_METER_ID=OWNER:mtr_meter_id
STRIPE_METER_AGGREGATION=last
STRIPE_METERED_USAGE_ENABLED=true
STRIPE_METER_EVENT_NAME=OWNER:meter_event_name
STRIPE_USAGE_SNAPSHOT_INTERVAL_SECONDS=300
# Optional credit packs (set all three or none): STRIPE_PRICE_CREDIT_PACK_100, _500, _2000.

# -- 7. Legal and public contacts (OWNER and counsel; see docs/launch/legal-review-packet.md)
# Compiled into the web image. Mailboxes must be monitored.
NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=OWNER:privacy-mailbox
NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=OWNER:support-mailbox
NEXT_PUBLIC_DPA_CONTACT_EMAIL=OWNER:dpa-mailbox
# Business name, address, governing law, effective date and the approval switch live in
# packages/config/legal-launch.json, not here. The PAID_GA_* values must agree with it.
PAID_GA_LEGAL_APPROVED=false
PAID_GA_CONTRACTING_ENTITY=OWNER:legal-entity-name-identical-to-legal-launch-json
PAID_GA_TERMS_VERSION=OWNER:terms-version-identical-to-legal-launch-json
PAID_GA_DPA_VERSION=OWNER:dpa-version
PAID_GA_COUNSEL_APPROVAL_OWNER=OWNER:counsel-approver
PAID_GA_COUNSEL_APPROVED_AT=OWNER:YYYY-MM-DD
PAID_GA_INCIDENT_NOTICE_HOURS=OWNER:hours-1-to-168
PAID_GA_SIGNATURE_PROCESS=OWNER:signature-process
PAID_GA_TRANSFER_TERMS=OWNER:transfer-terms
PAID_GA_CONTACT_OWNER_EMAIL=OWNER:legal-contact-mailbox
PAID_GA_APPROVAL_RECORD_URI=OWNER:s3://bucket/legal/approval-record.json

# -- 8. Signup mode (OWNER decision; see docs/launch/signup-modes.md) ----------
# Both must be identical. closed_beta needs no approval; invite_only and open need
# counsel approval recorded in legal-launch.json.
PUBLIC_SIGNUP_MODE=closed_beta
NEXT_PUBLIC_SIGNUP_MODE=closed_beta
PUBLIC_SIGNUP_INVITE_CODES=
# Cloudflare Turnstile (OWNER account); required only for PUBLIC_SIGNUP_MODE=open.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# -- 9. Postgres PITR: pgBackRest INSIDE the postgres container, repo2 = SFTP on the NAS --
# Required in production (deploy-release.sh fails closed if anything below is missing).
# File backups are host restic, owned by estate-infra. No object storage or offsite URI
# belongs here. The *_FILE values are HOST paths mounted read-only into postgres and
# copied into a postgres-owned tmpfs at start; never put the key or passphrase in this file.
# Schedules (backup full/diff) belong to estate-infra; see docs/estate/README.md.
PGBACKREST_ENABLED=true
PGBACKREST_STANZA=lunchlineup
PGBACKREST_SFTP_HOST=p0-nas01
# PGBACKREST_SFTP_PORT=22
PGBACKREST_SFTP_USER=OWNER:nas-chroot-user
PGBACKREST_REPO_PATH=/repo
PGBACKREST_SFTP_KEY_FILE=OWNER:/absolute/host/path/to/sftp-private-key
PGBACKREST_SFTP_KNOWN_HOSTS_FILE=OWNER:/absolute/host/path/to/pgbackrest_known_hosts
PGBACKREST_CIPHER_PASS_FILE=OWNER:/absolute/host/path/to/pgbackrest-cipher-pass
# PGBACKREST_RETENTION_FULL=4
# PGBACKREST_RETENTION_DIFF=7
# WAL archiving is switched on by the pgBackRest overlay (archive_mode=on and
# archive_command=pgbackrest --stanza=<stanza> archive-push %p); POSTGRES_ARCHIVE_MODE and
# POSTGRES_ARCHIVE_COMMAND are only for a manual, non-pgBackRest hook and stay unset.

# -- 10. Alerting, metrics and dashboards: ESTATE SYSTEMS, no keys here ---------
# Alertmanager, Prometheus, Grafana and Loki are estate services. The estate
# Prometheus scrapes http://<VM private IP>:9180/metrics/* with the bearer token
# in METRICS_TOKEN_FILE (docs/estate/README.md). No webhook or dashboard
# credentials belong in this file.
CONTROL_PLANE_PASSWORD=GENERATE_ME

# -- 11. Single sign-on (leave disabled unless the owner configures an IdP) -----
OIDC_ENABLED=false
NEXT_PUBLIC_OIDC_ENABLED=false

# -- 12. Launch proof evidence (produced by the release process, then recorded) --
LAUNCH_PROOF_MANIFEST_URI=OWNER:https://evidence-host/launch-proof/manifest.json
LAUNCH_PROOF_DAST_URL=OWNER:https://evidence-host/dast
LAUNCH_PROOF_LOAD_TEST_URL=OWNER:https://evidence-host/load-test
LAUNCH_PROOF_DR_DRILL_URI=OWNER:s3://bucket/launch-proof/dr-drill.json
LAUNCH_PROOF_ALERT_ROUTE_URL=OWNER:https://alert-routing-evidence
LAUNCH_PROOF_EXTERNAL_HEALTH_URL=OWNER:https://external-health-check
