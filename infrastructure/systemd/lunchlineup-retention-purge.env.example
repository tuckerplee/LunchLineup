# Optional overrides for the containerized retention scheduler. Append only the
# lines you need to /opt/lunchlineup-secrets/runtime.env (the Compose --env-file);
# the systemd units do not read a separate /etc/lunchlineup/retention-purge.env.
# The units pin stage, dry-run, confirmation, proof, metrics and lock paths; the
# endpoint is the private http://api-v2:3002/v2/admin/retention/purge-expired.

# Token source mounted as the Compose secret retention_purge_token (also read by the API).
RETENTION_PURGE_SERVICE_TOKEN_SECRET_FILE=/opt/lunchlineup-secrets/retention_purge_token

# Container identity; must be able to read the token and write both directories below.
RETENTION_PURGE_UID=1000
RETENTION_PURGE_GID=1000

# Host directories bind-mounted into the one-shot container (must already exist).
RETENTION_PROOF_DIR=/var/lib/lunchlineup/proofs
RETENTION_TEXTFILE_DIR=/var/lib/node_exporter/textfile_collector

RETENTION_PURGE_TIMEOUT_MS=30000
RETENTION_PURGE_MAX_PAGES=20
