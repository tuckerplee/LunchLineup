[Unit]
Description=LunchLineup seven-year retained-record eligibility review (one-shot container)
Documentation=file:/opt/lunchlineup/current/docs/runbooks/data-retention-delete-export.md
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target
ConditionPathExists=/opt/lunchlineup-secrets/runtime.env

[Service]
Type=oneshot
User=root
WorkingDirectory=/opt/lunchlineup
TimeoutStartSec=30min
Environment=RETENTION_PURGE_STAGE=retained_records
Environment=RETENTION_PURGE_DRY_RUN=true
Environment=RETENTION_PURGE_PROOF_FILE=/var/lib/lunchlineup/proofs/retained-record-review-latest.json
Environment=RETENTION_PURGE_METRICS_FILE=/var/lib/node_exporter/textfile_collector/lunchlineup_retained_record_review.prom
Environment=RETENTION_PURGE_LOCK_FILE=/tmp/retained-record-review.lock
ExecStart=/usr/bin/flock -w 600 /run/lock/lunchlineup-deploy.lock /bin/sh /opt/lunchlineup/infrastructure/systemd/run-retention-scheduler.sh
