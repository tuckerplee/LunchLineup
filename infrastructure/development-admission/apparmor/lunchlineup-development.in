# Source policy, NOT an installer or loaded policy receipt.
# Both mandatory files below are separately owner-approved immutable inputs.
# No distro abstractions, optional includes, complain fallback or generic exec.
abi "/etc/lunchlineup/lsm/approved.abi",
include "/etc/lunchlineup/lsm/approved-paths"

profile lunchlineup-development-supervisor flags=(mediate_deleted) {
  @{LL_PYTHON} rix,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  @{LL_PUBLIC_INPUTS} r,
  @{LL_NONCE_DIRECTORY}/ r,
  @{LL_NONCE_DIRECTORY}/* rw,
  /run/lock/lunchlineup-deploy.lock rw,
  deny /run/lock/lunchlineup-deploy.lock k,
  /dev/null rw,
  /dev/urandom r,
  /etc/machine-id r,
  /proc/sys/kernel/random/boot_id r,
  /proc/locks r,
  /proc/[0-9]*/{stat,status,cgroup,cmdline,attr/current,exe,fd/*} r,
  /etc/systemd/system/lunchlineup-development-guardian.service r,
  unix (getattr,getopt,setopt) type=seqpacket,
  unix (send,receive) type=seqpacket peer=(label=lunchlineup-development-guardian),
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (receive) set=(term,kill) peer=lunchlineup-development-guardian,
  signal (receive) set=(term,kill) peer=unconfined,
  deny capability,
  deny userns,
  deny network inet,
  deny network inet6,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace (trace),
  deny /proc/[0-9]*/{mem,environ,root/**,map_files/**} rw,
  deny /run/lunchlineup/engine-custody/raw/** rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny /etc/lunchlineup/trust/development-guardian.json rwklmx,
  deny /run/{docker.sock,containerd/**,systemd/private,dbus/system_bus_socket} rw,
  deny @{LL_STORE}/** rwklmx,
  # No change_profile, executable other than pinned interpreter, privileged
  # systemd/DBus socket, host socket, policy administration or key path grant.
}

profile lunchlineup-development-worker flags=(mediate_deleted) {
  @{LL_PYTHON} rix,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  @{LL_WORKER_INPUTS} r,
  /run/lock/lunchlineup-deploy.lock rw,
  deny /run/lock/lunchlineup-deploy.lock k,
  /dev/null rw,
  /dev/urandom r,
  /proc/[0-9]*/{stat,status,cgroup,attr/current,fd/*} r,
  unix (getattr,getopt,setopt) type=seqpacket,
  unix (send,receive) type=seqpacket peer=(label=lunchlineup-development-guardian),
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (receive) set=(term,kill) peer=lunchlineup-development-guardian,
  signal (receive) set=(term,kill) peer=unconfined,
  deny capability,
  deny userns,
  deny network inet,
  deny network inet6,
  deny mount,
  deny umount,
  deny pivot_root,
  deny ptrace (trace),
  deny /proc/[0-9]*/{mem,environ,root/**,map_files/**} rw,
  deny /run/lunchlineup/engine-custody/raw/** rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny /run/{docker.sock,containerd/**,systemd/private,dbus/system_bus_socket} rw,
  deny @{LL_STORE}/** rwklmx,
}

profile lunchlineup-development-broker flags=(mediate_deleted) {
  @{LL_DOCKER} rix,
  @{LL_LIBRARIES} mr,
  /run/lunchlineup/engine-custody/clients/ r,
  /run/lunchlineup/engine-custody/clients/*/ r,
  /run/lunchlineup/engine-custody/clients/*/config.json r,
  /dev/null rw,
  /dev/urandom r,
  /proc/{meminfo,stat,sys/kernel/osrelease} r,
  /proc/[0-9]*/{stat,status,cgroup,fd/*} r,
  /run/lunchlineup/engine-custody/client.sock rw,
  unix (create,getattr,getopt,setopt,shutdown) type=stream,
  # Exact pathname proxy grant only; raw engine sockets are denied below.
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (receive) set=(term,kill) peer=lunchlineup-development-guardian,
  signal (receive) set=(term,kill) peer=unconfined,
  deny capability,
  deny userns,
  deny network inet,
  deny network inet6,
  deny mount,
  deny ptrace (trace),
  deny /proc/[0-9]*/{mem,environ,root/**,map_files/**} rw,
  deny /run/lunchlineup/engine-custody/raw/** rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny /run/{containerd/**,systemd/private,dbus/system_bus_socket} rw,
  deny @{LL_STORE}/** rwklmx,
  # No credential helpers/plugins/shell execution, transition or alternate host.
}

profile lunchlineup-development-guardian flags=(mediate_deleted) {
  # Both ExecStart and ExecStopPost use this exact pinned interpreter.
  # Finalizer is a fixed read-only script argument, never a wildcard exec grant.
  @{LL_PYTHON} rix,
  @{LL_SSH} rix,
  @{LL_SYSTEMCTL} rix,
  @{LL_DOCKER} rix,
  # Physical collector pins both engines; inspection-only reads.
  /usr/bin/dockerd r,
  /usr/bin/containerd r,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  /usr/local/libexec/lunchlineup/development-* r,
  /etc/lunchlineup/** r,
  /etc/{machine-id,passwd,group,ld.so.cache,nsswitch.conf} r,
  /etc/ssh/** r,
  /etc/systemd/** r,
  /run/systemd/** r,
  /run/systemd/{private,notify} rw,
  /run/dbus/system_bus_socket rw,
  /run/lunchlineup/** rwk,
  @{LL_GUARDIAN_JOURNALS}/ rwk,
  @{LL_GUARDIAN_JOURNALS}/** rwk,
  @{LL_PROOFS}/** rw,
  @{LL_NONCE_DIRECTORY}/** rw,
  @{LL_PUBLIC_INPUTS} r,
  @{LL_WORKER_INPUTS} r,
  /run/lock/lunchlineup-deploy.lock rwk,
  /proc/** r,
  /proc/[0-9]*/attr/exec w,
  /sys/fs/cgroup/** r,
  @{LL_WORKER_CGROUP}/cgroup.{procs,kill} w,
  @{LL_BROKER_CGROUP}/cgroup.{procs,kill} w,
  /sys/kernel/security/apparmor/** r,
  /sys/module/apparmor/parameters/** r,
  /run/lunchlineup/engine-custody/client.sock rw,
  /run/lunchlineup/engine-custody/control.sock rw,
  @{LL_STORE}/ r,
  /dev/null rw,
  /dev/urandom r,
  network inet stream,
  network inet6 stream,
  unix,
  ptrace (read),
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (send) set=(term,kill),
  signal (receive),
  capability sys_ptrace,
  capability sys_admin,
  capability setuid,
  capability setgid,
  capability setpcap,
  capability dac_read_search,
  capability dac_override,
  change_profile -> lunchlineup-development-supervisor,
  change_profile -> lunchlineup-development-worker,
  change_profile -> lunchlineup-development-broker,
  deny ptrace (trace),
  deny /proc/[0-9]*/mem rw,
  deny /run/{docker.sock,containerd/**} rwklmx,
  deny /run/lunchlineup/engine-custody/raw/** rwklmx,
  deny /sys/kernel/security/apparmor/{.load,.replace,.remove} w,
  deny mount,
  deny umount,
  # Trusted pinned owner control only. No arbitrary external request can execute
  # these commands or use its key/channel; candidates cannot enter this profile.
}

profile lunchlineup-development-daemon flags=(mediate_deleted) {
  @{LL_DOCKERD} rix,
  @{LL_LIBRARIES} mr,
  /etc/lunchlineup/native/daemon.json r,
  /etc/docker/plugins/lunchlineup-readonly.spec r,
  /etc/{passwd,group,ld.so.cache,os-release} r,
  /dev/null rw,
  /dev/urandom r,
  /proc/{meminfo,stat,filesystems,mounts,sys/kernel/**} r,
  /proc/[0-9]*/{stat,status,cgroup,mountinfo,fd/*} r,
  /sys/fs/cgroup/** r,
  @{LL_STORE}/** rwk,
  /run/lunchlineup/engine-custody/raw/ rw,
  /run/lunchlineup/engine-custody/raw/docker.sock rw,
  /run/lunchlineup/engine-custody/raw/docker.pid rw,
  /run/lunchlineup/engine-custody/raw/docker-exec/** rwk,
  /run/lunchlineup/engine-custody/raw/containerd.sock rw,
  /run/lunchlineup/engine-custody/plugin.sock rw,
  unix (create,getattr,getopt,setopt,shutdown) type=stream,
  unix (listen,accept) type=stream,
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  ptrace (readby) peer=lunchlineup-development-recovery,
  signal (receive) set=(term,kill) peer=unconfined,
  deny network inet,
  deny network inet6,
  deny ptrace (trace),
  deny mount,
  deny umount,
  deny /etc/lunchlineup/private/** rwklmx,
  deny /run/{docker.sock,containerd/**} rwklmx,
  deny /sys/fs/cgroup/** w,
  # No Python/systemctl/runc/shim/helper exec or profile transition after exec.
}

profile lunchlineup-development-containerd flags=(mediate_deleted) {
  @{LL_CONTAINERD} rix,
  @{LL_LIBRARIES} mr,
  /etc/lunchlineup/native/containerd.toml r,
  /dev/null rw,
  /dev/urandom r,
  /proc/{meminfo,stat,filesystems,mounts} r,
  /proc/[0-9]*/{stat,status,cgroup,mountinfo,fd/*} r,
  /sys/fs/cgroup/** r,
  @{LL_CONTAINERD_ROOT}/** rwk,
  /run/lunchlineup/engine-custody/raw/ rw,
  /run/lunchlineup/engine-custody/raw/containerd-state/** rwk,
  /run/lunchlineup/engine-custody/raw/containerd.sock rw,
  /run/lunchlineup/engine-custody/raw/containerd.sock.ttrpc rw,
  unix (create,getattr,getopt,setopt,shutdown) type=stream,
  unix (listen,accept) type=stream,
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  ptrace (readby) peer=lunchlineup-development-recovery,
  signal (receive) set=(term,kill) peer=unconfined,
  deny network inet,
  deny network inet6,
  deny ptrace (trace),
  deny mount,
  deny umount,
  deny /etc/lunchlineup/private/** rwklmx,
  deny /run/{docker.sock,containerd/**} rwklmx,
  deny /sys/fs/cgroup/** w,
  # No runc/shim executable or transition permission; GC plugin disabled in pin.
}

profile lunchlineup-development-engine-launcher flags=(mediate_deleted) {
  @{LL_PYTHON} rix,
  @{LL_SYSTEMCTL} rix,
  @{LL_DOCKERD} rix,
  @{LL_CONTAINERD} rix,
  # Shared Settings pins the CLI too; launcher cannot execute this role.
  /usr/bin/docker r,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  /usr/local/libexec/lunchlineup/development-* r,
  /etc/lunchlineup/** r,
  /etc/docker/plugins/lunchlineup-readonly.spec r,
  /etc/{machine-id,ld.so.cache,passwd,group} r,
  /etc/systemd/** r,
  /run/systemd/** r,
  /run/systemd/private rw,
  /run/dbus/system_bus_socket rw,
  /run/lunchlineup/engine-custody/control.sock rw,
  /proc/** r,
  /proc/[0-9]*/attr/exec w,
  /sys/fs/cgroup/** r,
  /sys/kernel/security/apparmor/** r,
  /sys/module/apparmor/parameters/** r,
  /dev/null rw,
  /dev/urandom r,
  unix,
  capability sys_ptrace,
  capability dac_read_search,
  ptrace (read),
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (receive) set=(term,kill) peer=unconfined,
  change_profile -> lunchlineup-development-daemon,
  change_profile -> lunchlineup-development-containerd,
  deny /run/lunchlineup/engine-custody/raw/** rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny network inet,
  deny network inet6,
  deny userns,
  deny mount,
  deny umount,
  deny ptrace (trace),
  deny /proc/[0-9]*/mem rw,
}

profile lunchlineup-development-engine-custodian flags=(mediate_deleted) {
  @{LL_PYTHON} rix,
  @{LL_SYSTEMCTL} rix,
  # Settings hashes these fixed roles; read only, never engine execution.
  /usr/bin/dockerd r,
  /usr/bin/containerd r,
  /usr/bin/docker r,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  /usr/local/libexec/lunchlineup/development-* r,
  /etc/lunchlineup/** r,
  /etc/docker/plugins/lunchlineup-readonly.spec r,
  /etc/{machine-id,ld.so.cache,passwd,group} r,
  /etc/systemd/** r,
  /run/systemd/** r,
  /run/systemd/{private,notify} rw,
  /run/dbus/system_bus_socket rw,
  /run/lunchlineup/ rw,
  /run/lunchlineup/engine-custody/ rwk,
  /run/lunchlineup/engine-custody/** rwk,
  /var/lib/lunchlineup/engine-custody/ rwk,
  /var/lib/lunchlineup/engine-custody/** rwk,
  @{LL_STORE}/ r,
  @{LL_STORE}/containers/ r,
  @{LL_STORE}/containers/*/{hostconfig.json,config.v2.json} r,
  @{LL_STORE}/plugins/** r,
  @{LL_CONTAINERD_ROOT}/ r,
  /proc/** r,
  /sys/fs/cgroup/** r,
  /sys/kernel/security/apparmor/** r,
  /sys/module/apparmor/parameters/** r,
  /dev/null rw,
  /dev/urandom r,
  unix,
  capability sys_ptrace,
  capability dac_read_search,
  ptrace (read),
  ptrace (readby) peer=lunchlineup-development-engine-launcher,
  ptrace (readby) peer=lunchlineup-development-guardian,
  ptrace (readby) peer=lunchlineup-development-recovery,
  signal (receive) set=(term,kill) peer=unconfined,
  signal (send) set=(kill) peer=lunchlineup-development-engine-custodian,
  deny /run/lunchlineup/engine-custody/raw/containerd* rwklmx,
  deny /run/{docker.sock,containerd/**} rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny network inet,
  deny network inet6,
  deny userns,
  deny mount,
  deny umount,
  deny ptrace (trace),
  deny /proc/[0-9]*/mem rw,
  # Native code can start only two fixed new units through pinned systemctl.
  # No data-store writes, Manager key, arbitrary engine API or stale-path reuse.
}

profile lunchlineup-development-recovery flags=(mediate_deleted) {
  @{LL_PYTHON} rix,
  @{LL_SYSTEMCTL} rix,
  # Settings hashes these fixed roles; read only, never engine execution.
  /usr/bin/dockerd r,
  /usr/bin/containerd r,
  /usr/bin/docker r,
  @{LL_LIBRARIES} mr,
  @{LL_STDLIB} r,
  /usr/local/libexec/lunchlineup/development-* r,
  /etc/lunchlineup/** r,
  /etc/docker/plugins/lunchlineup-readonly.spec r,
  /etc/{machine-id,ld.so.cache,passwd,group} r,
  /etc/systemd/** r,
  /run/systemd/** r,
  /run/systemd/private rw,
  /run/dbus/system_bus_socket rw,
  /run/lunchlineup/ r,
  /run/lunchlineup/development-writer.owner rk,
  /run/lunchlineup/engine-custody/control.sock rw,
  /run/lock/lunchlineup-deploy.lock rk,
  @{LL_GUARDIAN_JOURNALS}/ rk,
  @{LL_GUARDIAN_JOURNALS}/** r,
  @{LL_NONCE_DIRECTORY}/ rk,
  @{LL_NONCE_DIRECTORY}/** r,
  @{LL_PROOFS}/** r,
  /var/lib/lunchlineup/engine-custody/ rk,
  /var/lib/lunchlineup/engine-custody/** r,
  /proc/** r,
  /sys/fs/cgroup/** r,
  /sys/kernel/security/apparmor/** r,
  /sys/module/apparmor/parameters/** r,
  /dev/null rw,
  /dev/urandom r,
  unix (create,getattr,getopt,setopt,shutdown) type=stream,
  unix (create,getattr,getopt,setopt,shutdown) type=seqpacket,
  capability sys_ptrace,
  capability dac_read_search,
  ptrace (read),
  ptrace (readby) peer=lunchlineup-development-engine-custodian,
  signal (receive) set=(term,kill) peer=unconfined,
  signal (send) set=(kill) peer=lunchlineup-development-recovery,
  deny /run/lunchlineup/engine-custody/{raw/**,client.sock,plugin.sock} rwklmx,
  deny /run/{docker.sock,containerd/**} rwklmx,
  deny /etc/lunchlineup/private/** rwklmx,
  deny network inet,
  deny network inet6,
  deny userns,
  deny mount,
  deny umount,
  deny ptrace (trace),
  deny /proc/[0-9]*/mem rw,
  # Read/lock protected evidence only; no WAL/fence/registry writes or engine IPC.
}
