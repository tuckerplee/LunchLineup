# infrastructure/docker/Dockerfile.api-v2
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_LOGLEVEL=error \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_loglevel=error \
    npm_config_update_notifier=false \
    CHECKPOINT_DISABLE=1 \
    DO_NOT_TRACK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NO_UPDATE_NOTIFIER=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    TURBO_TELEMETRY_DISABLED=1

RUN apk update && apk add openssl && rm -rf /var/cache/apk/*
COPY . .
RUN npm ci --prefer-offline || npm ci
RUN npx turbo run build --env-mode=loose --filter=@lunchlineup/api-v2

FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
WORKDIR /app

ARG VCS_REF=local
LABEL org.opencontainers.image.source="https://github.com/tuckerplee/LunchLineup" \
      org.opencontainers.image.revision="${VCS_REF}"

ENV NODE_ENV=production \
    HOME=/home/node \
    TMPDIR=/tmp \
    CHECKPOINT_DISABLE=1 \
    NO_UPDATE_NOTIFIER=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=true

RUN apk update && apk add openssl && rm -rf /var/cache/apk/*
COPY --from=builder /app/apps/api-v2/dist /app/dist
COPY --from=builder /app/apps/api-v2/package.json /app/package.json
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/packages /app/packages
RUN ./node_modules/.bin/prisma generate --schema=/app/packages/db/prisma/schema.prisma --no-hints

# Prisma generation is complete; keep only runtime workspace dependencies in
# the final image so development-only vulnerability paths are not shipped.
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund

# The runtime starts the compiled service with node, not npm.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

USER node
EXPOSE 3002
CMD ["node", "dist/main.js"]
