# infrastructure/docker/Dockerfile.web
# Stage 1: Build
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_LOGLEVEL=error \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_loglevel=error \
    npm_config_update_notifier=false \
    CHECKPOINT_DISABLE=1 \
    DO_NOT_TRACK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NO_UPDATE_NOTIFIER=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    TURBO_TELEMETRY_DISABLED=1

RUN apk update && apk add openssl && rm -rf /var/cache/apk/*

ARG NEXT_PUBLIC_API_URL=/api/v2
ARG INTERNAL_API_V2_URL=http://api-v2:3002/v2
ARG NEXT_PUBLIC_OIDC_ENABLED=false
ARG NEXT_PUBLIC_SIGNUP_MODE=closed_beta
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@lunchlineup.example
ARG NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=support@lunchlineup.example
ARG NEXT_PUBLIC_DPA_CONTACT_EMAIL=privacy@lunchlineup.example
ARG NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_ENV=production
ARG DEPLOY_RELEASE_SHA
ARG PUBLIC_BUILD_CONFIG_SHA256

ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    INTERNAL_API_V2_URL=$INTERNAL_API_V2_URL \
    NEXT_PUBLIC_OIDC_ENABLED=$NEXT_PUBLIC_OIDC_ENABLED \
    NEXT_PUBLIC_SIGNUP_MODE=$NEXT_PUBLIC_SIGNUP_MODE \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=$NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL \
    NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=$NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL \
    NEXT_PUBLIC_DPA_CONTACT_EMAIL=$NEXT_PUBLIC_DPA_CONTACT_EMAIL \
    NEXT_PUBLIC_APP_ORIGIN=$NEXT_PUBLIC_APP_ORIGIN \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV

# Copy full monorepo (needed for workspace package resolution)
COPY . .

RUN npm ci --prefer-offline || npm ci

RUN npx turbo run build --env-mode=loose --filter=@lunchlineup/web

RUN node -e 'const fs=require("node:fs"); const contract={sourceSha:process.env.DEPLOY_RELEASE_SHA,publicBuildConfigSha256:process.env.PUBLIC_BUILD_CONFIG_SHA256,nextPublicApiUrl:process.env.NEXT_PUBLIC_API_URL,nextPublicAppOrigin:process.env.NEXT_PUBLIC_APP_ORIGIN,nextPublicAppUrl:process.env.NEXT_PUBLIC_APP_URL,nextPublicAppEnv:process.env.NEXT_PUBLIC_APP_ENV,nextPublicSignupMode:process.env.NEXT_PUBLIC_SIGNUP_MODE,nextPublicOidcEnabled:process.env.NEXT_PUBLIC_OIDC_ENABLED,nextPublicTurnstileSiteKey:process.env.NEXT_PUBLIC_TURNSTILE_SITE_KEY,nextPublicPrivacyContactEmail:process.env.NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL,nextPublicSupportContactEmail:process.env.NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL,nextPublicDpaContactEmail:process.env.NEXT_PUBLIC_DPA_CONTACT_EMAIL}; if(!/^[a-f0-9]{40}$/.test(contract.sourceSha||"")||!/^[a-f0-9]{64}$/.test(contract.publicBuildConfigSha256||"")) throw new Error("exact public build identity required"); fs.mkdirSync("/app/apps/web/public/.well-known",{recursive:true}); fs.writeFileSync("/app/apps/web/public/.well-known/lunchlineup-build.json",JSON.stringify(contract)+"\n",{flag:"wx"});'

# Stage 2: Runtime
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
WORKDIR /app

ARG NEXT_PUBLIC_API_URL=/api/v2
ARG INTERNAL_API_V2_URL=http://api-v2:3002/v2
ARG NEXT_PUBLIC_OIDC_ENABLED=false
ARG NEXT_PUBLIC_SIGNUP_MODE=closed_beta
ARG NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ARG NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=privacy@lunchlineup.example
ARG NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=support@lunchlineup.example
ARG NEXT_PUBLIC_DPA_CONTACT_EMAIL=privacy@lunchlineup.example
ARG NEXT_PUBLIC_APP_ORIGIN=http://localhost:3000
ARG NEXT_PUBLIC_APP_URL=http://localhost:3000
ARG NEXT_PUBLIC_APP_ENV=production

ENV NODE_ENV=production \
    HOME=/home/node \
    TMPDIR=/tmp \
    CHECKPOINT_DISABLE=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NO_UPDATE_NOTIFIER=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL \
    INTERNAL_API_V2_URL=$INTERNAL_API_V2_URL \
    NEXT_PUBLIC_OIDC_ENABLED=$NEXT_PUBLIC_OIDC_ENABLED \
    NEXT_PUBLIC_SIGNUP_MODE=$NEXT_PUBLIC_SIGNUP_MODE \
    NEXT_PUBLIC_TURNSTILE_SITE_KEY=$NEXT_PUBLIC_TURNSTILE_SITE_KEY \
    NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL=$NEXT_PUBLIC_PRIVACY_CONTACT_EMAIL \
    NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL=$NEXT_PUBLIC_SUPPORT_CONTACT_EMAIL \
    NEXT_PUBLIC_DPA_CONTACT_EMAIL=$NEXT_PUBLIC_DPA_CONTACT_EMAIL \
    NEXT_PUBLIC_APP_ORIGIN=$NEXT_PUBLIC_APP_ORIGIN \
    NEXT_PUBLIC_APP_URL=$NEXT_PUBLIC_APP_URL \
    NEXT_PUBLIC_APP_ENV=$NEXT_PUBLIC_APP_ENV

# Copy Next.js build output and static assets
COPY --from=builder /app/apps/web/.next /app/.next
COPY --from=builder /app/apps/web/public /app/public
COPY --from=builder /app/apps/web/package.json /app/package.json

# Copy node_modules from builder to avoid workspace resolution issues
COPY --from=builder /app/node_modules /app/node_modules

# Next's production server needs the app dependencies only. Pruning the
# copied workspace tree removes Storybook/Vite tooling and vulnerable dev-only
# transitive packages from the browser runtime.
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund

# Start Next through node directly, then remove npm/corepack from the runtime
# image so the build toolchain is not shipped as an attack surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

RUN mkdir -p /app/.next/cache && chown node:node /app/.next/cache

USER node

EXPOSE 3000
CMD ["node", "node_modules/next/dist/bin/next", "start"]
