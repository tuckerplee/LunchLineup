# infrastructure/docker/Dockerfile.api
# Stage 1: Build
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS builder
WORKDIR /app
ENV NPM_CONFIG_AUDIT=false \
    NPM_CONFIG_FUND=false \
    NPM_CONFIG_LOGLEVEL=error \
    NPM_CONFIG_UPDATE_NOTIFIER=false \
    npm_config_audit=false \
    npm_config_fund=false \
    npm_config_loglevel=error \
    npm_config_update_notifier=false \
    CHECKPOINT_DISABLE=1 \
    DO_NOT_TRACK=1 \
    NEXT_TELEMETRY_DISABLED=1 \
    NO_UPDATE_NOTIFIER=1 \
    PRISMA_HIDE_UPDATE_MESSAGE=true \
    TURBO_TELEMETRY_DISABLED=1

# Prisma requires openssl at build time for prisma generate
RUN apk update && apk add openssl && rm -rf /var/cache/apk/*

# Copy full monorepo (workspace packages are local deps)
COPY . .

# Install all deps (including workspace packages)
RUN npm ci --prefer-offline || npm ci

# Build only the API and its dependencies
RUN npx turbo run build --env-mode=loose --filter=@lunchlineup/api

# Normalize the compiled output into a stable path for the runtime stage.
RUN if [ -d /app/apps/api/dist ]; then \
      rm -rf /app/api-dist && mkdir -p /app/api-dist && cp -R /app/apps/api/dist/. /app/api-dist/; \
    elif [ -d /app/dist ]; then \
      rm -rf /app/api-dist && mkdir -p /app/api-dist && cp -R /app/dist/. /app/api-dist/; \
    else \
      echo "API build output not found" >&2; \
      find /app -maxdepth 3 -type d | sort >&2; \
      exit 1; \
    fi

# Stage 2: Runtime — copy built artifacts + node_modules from builder
FROM node:22-alpine@sha256:c610fcdfb1d5b4740dd70c284ed3cb16bb857e0f7166196e36a5501df7a3aa32 AS runner
WORKDIR /app
ENV NODE_ENV=production
ENV HOME=/home/node TMPDIR=/tmp CHECKPOINT_DISABLE=1 NO_UPDATE_NOTIFIER=1 PRISMA_HIDE_UPDATE_MESSAGE=true

# Prisma native engine requires libssl.so.1.1 — install OpenSSL compat
RUN apk update && apk add openssl && rm -rf /var/cache/apk/*

# Copy compiled output
COPY --from=builder /app/api-dist /app/dist

# Copy node_modules from builder, including API workspace-local modules.
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/api/node_modules /app/node_modules
COPY --from=builder /app/apps/api/package.json /app/package.json

# Copy workspace packages needed at runtime
COPY --from=builder /app/packages /app/packages

# Keep the launch-time provider preflight candidate-bound. Disposable hosts run
# this script through the built API image and do not require a host Node runtime.
COPY --from=builder /app/scripts/production-launch-policy-shared.mjs /app/scripts/production-launch-policy-shared.mjs
COPY --from=builder /app/scripts/verify-resend-readiness.mjs /app/scripts/verify-resend-readiness.mjs

# Ensure runtime Prisma client artifacts are generated in the final image.
RUN ./node_modules/.bin/prisma generate --schema=/app/packages/db/prisma/schema.prisma --no-hints

# The builder needs the full toolchain; the API runtime does not. Remove
# workspace-only dev tooling (including Storybook/Vite and their transitive
# parsers) after Prisma generation so the shipped image is production-only.
RUN npm prune --omit=dev --ignore-scripts --no-audit --no-fund

# The production process invokes node directly. Keep npm/corepack out of the
# shipped image so the builder's package-manager tree cannot become a runtime
# vulnerability surface.
RUN rm -rf /usr/local/lib/node_modules/npm /usr/local/lib/node_modules/corepack \
    && rm -f /usr/local/bin/npm /usr/local/bin/npx /usr/local/bin/corepack

# Seed the named export volume with ownership for the non-root API process.
RUN mkdir -p /var/lib/lunchlineup/tenant-exports \
    && chown node:node /var/lib/lunchlineup/tenant-exports \
    && chmod 0700 /var/lib/lunchlineup/tenant-exports

USER node

EXPOSE 3000
CMD ["node", "dist/main"]
