# syntax=docker/dockerfile:1.7

FROM golang:1.26.6-alpine3.23@sha256:e57c41c1d5864341031181b0db34b9a537bb5773eb6428e4e5bdaea0f9135406 AS build
RUN apk add --no-cache git
RUN git init /src \
    && cd /src \
    && git remote add origin https://github.com/grafana/tempo.git \
    && git fetch --depth 1 origin f0f3ed59197bfe9f54f3b0f8015ccca112f9e544 \
    && git checkout --detach f0f3ed59197bfe9f54f3b0f8015ccca112f9e544 \
    && test "$(git rev-parse HEAD)" = "f0f3ed59197bfe9f54f3b0f8015ccca112f9e544"
WORKDIR /src
RUN grep -F 'github.com/prometheus/prometheus v0.311.3' go.mod \
    && grep -F 'go.opentelemetry.io/otel v1.44.0' go.mod \
    && grep -F 'go.opentelemetry.io/otel/sdk v1.43.0' go.mod \
    && grep -F 'google.golang.org/grpc v1.82.1' go.mod \
    && grep -F 'golang.org/x/crypto v0.53.0' go.mod \
    && grep -F 'golang.org/x/net v0.56.0' go.mod \
    && grep -F 'golang.org/x/text v0.39.0' go.mod
RUN CGO_ENABLED=0 GOAMD64=v2 go build -trimpath \
    -ldflags '-s -w -X main.Branch=HEAD -X main.Revision=f0f3ed59197bfe9f54f3b0f8015ccca112f9e544 -X main.Version=2.10.8' \
    -o /out/tempo ./cmd/tempo

FROM grafana/tempo:2.10.8@sha256:f0561deb1c68ec44d6e6e7e4487f30106c4e5e768642077695b37958b105812a
COPY --from=build /out/tempo /tempo
