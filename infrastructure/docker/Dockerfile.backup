# infrastructure/docker/Dockerfile.backup
# Build the object-store client from a pinned source revision with current Go
# security fixes. The published MinIO client image bundled an old Go toolchain
# and transitive modules that the release Trivy gate correctly rejected.
FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS pitr-client-builder
ARG MC_COMMIT=d6541ea280b73a834b64d4097e21f2be77676104
WORKDIR /src
RUN apk add --no-cache ca-certificates git
RUN git init . \
  && git remote add origin https://github.com/minio/mc.git \
  && git fetch --depth 1 origin "$MC_COMMIT" \
  && git checkout --detach FETCH_HEAD
RUN go mod edit \
      -require=github.com/prometheus/prometheus@v0.314.0 \
      -require=golang.org/x/crypto@v0.55.0 \
      -require=golang.org/x/net@v0.58.0 \
      -require=golang.org/x/text@v0.41.0 \
      -require=google.golang.org/grpc@v1.83.1 \
  && go mod tidy
RUN CGO_ENABLED=0 go build -trimpath -buildvcs=false -ldflags='-s -w' -o /mc .

# Stage 2: Runtime
FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce AS runner
RUN mkdir -p /usr/share/man \
  && apk add --no-cache postgresql-client rsync zstd gpg aws-cli rclone nodejs coreutils \
  && if ! grep -q '^postgres:' /etc/group; then addgroup -S -g 70 postgres; fi \
  && if ! grep -q '^postgres:' /etc/passwd; then adduser -S -D -H -u 70 -G postgres postgres; fi
WORKDIR /app
COPY scripts/backup.sh .
COPY scripts/pitr-wal-provider.mjs .
COPY infrastructure/postgres/pitr-object-store.sh /opt/lunchlineup/infrastructure/postgres/pitr-object-store.sh
COPY infrastructure/postgres/pitr-export-lifecycle-policy.sh /opt/lunchlineup/infrastructure/postgres/pitr-export-lifecycle-policy.sh
COPY infrastructure/postgres/pitr-verify-object-store.sh /opt/lunchlineup/infrastructure/postgres/pitr-verify-object-store.sh
COPY infrastructure/postgres/pitr-wal-provider-upload.sh /opt/lunchlineup/infrastructure/postgres/pitr-wal-provider-upload.sh
COPY --from=pitr-client-builder /mc /opt/lunchlineup/tools/mc
RUN chmod +x \
  backup.sh \
  /opt/lunchlineup/infrastructure/postgres/pitr-object-store.sh \
  /opt/lunchlineup/infrastructure/postgres/pitr-export-lifecycle-policy.sh \
  /opt/lunchlineup/infrastructure/postgres/pitr-verify-object-store.sh \
  /opt/lunchlineup/infrastructure/postgres/pitr-wal-provider-upload.sh \
  /opt/lunchlineup/tools/mc
CMD ["./backup.sh"]
