{
	http_port 8080
	# CT940 nginx (10.231.10.30) terminates TLS and sends X-Forwarded-Proto/Host.
	# CADDY_TRUSTED_PROXIES (space-separated CIDRs, default is the current CT940 address;
	# 10.1.20.20/32 after the renumbering) overrides the address.
	# Trust only it so Caddy preserves https instead of overwriting with http.
	servers {
		trusted_proxies static {$CADDY_TRUSTED_PROXIES:10.231.10.30/32}
		trusted_proxies_strict
		client_ip_headers X-Forwarded-For
	}
	email {$ADMIN_EMAIL:admin@example.com}
}

http://127.0.0.1:2015 {
	respond /health 200
}

# Estate metrics gateway. The estate Prometheus scrapes this listener on the VM
# private IP (docs/estate/lunchlineup-targets.yml). It is not part of the public
# route chain (CT940 nginx only forwards VM port 80). Every request needs the
# same bearer token as the app /metrics endpoints (secret metrics_token); the
# unauthenticated worker, engine and webhook-replay exporters are only reachable
# through this authenticated gateway.
http://:9180 {
	@authorized header Authorization "Bearer {file./run/secrets/metrics_token}"
	handle @authorized {
		handle /metrics/api {
			rewrite * /metrics
			reverse_proxy api:3000 {
				# The API host allow-list accepts api:3000 (API_INTERNAL_HOSTS), not the gateway address.
				header_up Host {upstream_hostport}
			}
		}
		handle /metrics/api-v2 {
			rewrite * /metrics
			reverse_proxy api-v2:3002
		}
		handle /metrics/worker {
			rewrite * /metrics
			reverse_proxy worker:3003
		}
		handle /metrics/engine {
			rewrite * /metrics
			reverse_proxy engine:8000
		}
		handle /metrics/webhook-replay {
			rewrite * /metrics
			reverse_proxy webhook-replay:3004
		}
		handle /metrics/control {
			rewrite * /api/metrics
			reverse_proxy control:3001
		}
		handle {
			respond "not found" 404
		}
	}
	handle {
		respond "unauthorized" 401
	}
}

{$CADDY_SITE_ADDRESSES:http://localhost:80, http://127.0.0.1:80, http://proxy:80} {
	encode zstd gzip
	request_body {
		max_size 10MB
	}

	header {
		X-LunchLineup-Release "{$DEPLOY_RELEASE_SHA:local}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Resource-Policy "same-origin"
		Origin-Agent-Cluster "?1"
		X-Content-Type-Options "nosniff"
		X-DNS-Prefetch-Control "off"
		X-Download-Options "noopen"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=()"
		X-Permitted-Cross-Domain-Policies "none"
		-X-Powered-By
		-Server
	}

	header /api/* Cache-Control "no-store"

	@betaWeb {
		host beta.lunchlineup.com {$PRIVATE_APP_HOST:localhost}
		not path /api/* /health
	}
	header @betaWeb Cache-Control "private, no-store, no-transform"

	handle /health {
		rewrite * /v2/ready
		reverse_proxy api-v2:3002
	}

	handle /api/health {
		rewrite * /v2/ready
		reverse_proxy api-v2:3002
	}

	handle /api/v2/* {
		uri strip_prefix /api
		reverse_proxy api-v2:3002
	}

	@stripeWebhook {
		method POST
		path /api/webhooks/stripe
	}
	handle @stripeWebhook {
		uri replace /api/webhooks/stripe /v1/billing/webhook
		reverse_proxy api:3000
	}

	@stripeMeterErrorsWebhook {
		method POST
		path /api/webhooks/stripe/meter-errors
	}
	handle @stripeMeterErrorsWebhook {
		uri replace /api/webhooks/stripe/meter-errors /v1/billing/meter-errors/webhook
		reverse_proxy api:3000
	}

	@resendDeliveryWebhook {
		method POST
		path /api/webhooks/resend/delivery-events
	}
	handle @resendDeliveryWebhook {
		uri replace /api/webhooks/resend/delivery-events /v1/email-delivery/provider-events
		reverse_proxy api:3000
	}

	# The former broad v1 application surface is deliberately terminal. The
	# three provider ingress paths above preserve their raw signed payloads while
	# their domain implementations finish migration behind the private network.
	handle /api/v1/* {
		respond "API version v1 has been retired." 410
	}

	handle {
		reverse_proxy web:3000
	}
}
