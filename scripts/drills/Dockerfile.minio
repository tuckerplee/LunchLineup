# Local drill only: S3-compatible object store with versioning + Object Lock.
# The upstream minio/minio images are no longer published, so build the server
# from a pinned source tag with the same toolchain image as Dockerfile.backup.
FROM golang:1.26.6-alpine@sha256:3889b425f035be855a72fb4755265311293b6d414521f0a519d819df32222d83 AS build
ARG MINIO_VERSION=v0.0.0-20260212201848-7aac2a2c5b7c
RUN apk add --no-cache git ca-certificates
RUN CGO_ENABLED=0 GOFLAGS=-trimpath go install -ldflags='-s -w' github.com/minio/minio@${MINIO_VERSION}

FROM alpine:3.22@sha256:14358309a308569c32bdc37e2e0e9694be33a9d99e68afb0f5ff33cc1f695dce
RUN apk add --no-cache ca-certificates curl
COPY --from=build /go/bin/minio /usr/local/bin/minio
ENV MINIO_BROWSER=off
EXPOSE 9000
ENTRYPOINT ["minio"]
CMD ["server", "/data", "--address", ":9000"]
