#!/usr/bin/env bash
set -euo pipefail
adapter="$(cd -- "$(dirname -- "$0")" && pwd)/podman"
if [[ "${1:-}" == compose ]]; then
  shift
  args=()
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --project-directory) cd -- "${2:?}"; shift 2;;
      --project-directory=*) cd -- "${1#*=}"; shift;;
      *) args+=("$1"); shift;;
    esac
  done
  for argument in "${args[@]}"; do
    if [[ "$argument" == config || "$argument" == version ]]; then
      exec /usr/bin/docker-compose "${args[@]}"
    fi
  done
  exec /usr/bin/podman-compose --podman-path "$adapter" --parallel 1 "${args[@]}"
fi
if [[ "${1:-}" == run ]]; then
  shift
  for argument in "$@"; do
    if [[ "$argument" == --group-add || "$argument" == --group-add=* ]]; then
      exec "$adapter" run "$@"
    fi
  done
  exec "$adapter" run --group-add keep-groups "$@"
fi
exec "$adapter" "$@"
