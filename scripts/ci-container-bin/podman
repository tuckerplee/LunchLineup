#!/usr/bin/env bash
# Every application QA container command uses the controller's explicit store.
set -euo pipefail
[[ "${CI_REPOSITORY:-}" == lunchlineup && "${CI_RUN_ID:-}" =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,159}$ ]] || exit 64
root="/var/lib/custom-ci/runs/$CI_RUN_ID/tmp"
[[ "${RUNNER_TEMP:-}" == "$root/job-tmp" && "${CONTAINERS_STORAGE_CONF:-}" == "$root/step-inputs/container-storage.conf" ]] || exit 64
[[ -z "${DOCKER_HOST:-}" && -z "${CONTAINER_HOST:-}" ]] || exit 64
for path in "$root/containers/graphroot" "$root/containers/runroot"; do
  [[ -d "$path" && "$(realpath -e "$path")" == "$path" ]] || exit 64
done
exec /usr/bin/podman --root "$root/containers/graphroot" --runroot "$root/containers/runroot" "$@"
